# Copy this file to .env in the repository root, or run setup-database.cmd.
# Replace placeholders with your dedicated local PostgreSQL connection.
# Explicit process environment variables override values from .env.
RPG_DATABASE_URL="postgresql://rpg_local_owner:REPLACE_WITH_PASSWORD@127.0.0.1:5432/rpg_local"

# Optional: database tests use a separate *_test database; setup-test-database.ps1 writes this line.
# RPG_TEST_DATABASE_URL="postgresql://rpg_local_test_owner:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5432/rpg_local_test"

# Optional cloud API providers (in addition to the CLIs). Both a key and a model list are required
# per provider; each provider uses its own variables. Restart the backend after editing.
# Models are comma-separated ids, best first. Enabling one sends the assembled campaign context to that service.
# GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
# GEMINI_MODELS="gemini-2.5-pro,gemini-2.5-flash"
# OPENROUTER_API_KEY="REPLACE_WITH_OPENROUTER_API_KEY"
# OpenRouter tries later list entries, in order, when the selected model is rate limited or unavailable; put openrouter/free last.
# OPENROUTER_MODELS="anthropic/claude-sonnet-4.5,google/gemini-2.5-pro,openrouter/free"

# Optional native NPC creator. Leave unset until verifying nested CLI tool waits/isolation.
# Uses the campaign provider; a new preparation consumes an additional generation call.
# RPG_NPC_PREPARATION_NATIVE=1
