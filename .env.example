# Copy this file to .env in the repository root, or run setup-database.cmd.
# Replace placeholders with your dedicated local PostgreSQL connection.
# Explicit process environment variables override values from .env.
RPG_DATABASE_URL="postgresql://rpg_local_owner:REPLACE_WITH_PASSWORD@127.0.0.1:5432/rpg_local"

# Optional: database tests use a separate *_test database; setup-test-database.ps1 writes this line.
# RPG_TEST_DATABASE_URL="postgresql://rpg_local_test_owner:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:5432/rpg_local_test"
